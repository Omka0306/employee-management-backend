{
  "info": {
    "name": "Employee Management API",
    "description": "Complete API collection for Employee Management Backend with AWS Cognito authentication",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://ec4msgjtx3.execute-api.ap-south-1.amazonaws.com/dev",
      "type": "string"
    },
    {
      "key": "authBaseUrl",
      "value": "https://ec4msgjtx3.execute-api.ap-south-1.amazonaws.com/dev",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "employeeId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Sign Up",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"SecurePassword123!\",\n  \"name\": \"John Doe\"\n}"
            },
            "url": {
              "raw": "{{authBaseUrl}}/auth/signup",
              "host": ["{{authBaseUrl}}"],
              "path": ["auth", "signup"]
            },
            "description": "Register a new user. User will receive a confirmation code via email."
          },
          "response": []
        },
        {
          "name": "Confirm Sign Up",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"code\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{authBaseUrl}}/auth/confirm",
              "host": ["{{authBaseUrl}}"],
              "path": ["auth", "confirm"]
            },
            "description": "Confirm user registration with the code received via email."
          },
          "response": []
        },
        {
          "name": "Sign In",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set('accessToken', response.accessToken);",
                  "    console.log('Access token saved to collection variable');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"SecurePassword123!\"\n}"
            },
            "url": {
              "raw": "{{authBaseUrl}}/auth/signin",
              "host": ["{{authBaseUrl}}"],
              "path": ["auth", "signin"]
            },
            "description": "Sign in and receive JWT tokens. Access token is automatically saved to collection variable."
          },
          "response": []
        }
      ],
      "description": "AWS Cognito authentication endpoints"
    },
    {
      "name": "Employees",
      "item": [
        {
          "name": "Create Employee",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set('employeeId', response.data.employeeId);",
                  "    console.log('Employee ID saved:', response.data.employeeId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"John\",\n  \"middleName\": \"Michael\",\n  \"lastName\": \"Doe\",\n  \"email\": \"john.doe@example.com\",\n  \"mobile\": \"9876543210\",\n  \"address\": {\n    \"street\": \"123 Main Street\",\n    \"city\": \"Mumbai\",\n    \"state\": \"Maharashtra\",\n    \"zipCode\": \"400001\",\n    \"country\": \"India\"\n  },\n  \"designation\": \"Software Engineer\",\n  \"department\": \"Engineering\",\n  \"dateOfJoining\": \"2025-01-15\",\n  \"salary\": 75000,\n  \"status\": \"active\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/employees",
              "host": ["{{baseUrl}}"],
              "path": ["api", "employees"]
            },
            "description": "Create a new employee. Employee ID is automatically saved to collection variable."
          },
          "response": []
        },
        {
          "name": "Get All Employees",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/employees?limit=50",
              "host": ["{{baseUrl}}"],
              "path": ["api", "employees"],
              "query": [
                {
                  "key": "limit",
                  "value": "50",
                  "description": "Number of employees to return"
                },
                {
                  "key": "status",
                  "value": "active",
                  "description": "Filter by status (active/inactive/terminated)",
                  "disabled": true
                },
                {
                  "key": "lastKey",
                  "value": "",
                  "description": "For pagination",
                  "disabled": true
                }
              ]
            },
            "description": "Retrieve all employees with optional filtering and pagination."
          },
          "response": []
        },
        {
          "name": "Get Employee by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/employees/{{employeeId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "employees", "{{employeeId}}"]
            },
            "description": "Retrieve a specific employee by their ID."
          },
          "response": []
        },
        {
          "name": "Update Employee",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"designation\": \"Senior Software Engineer\",\n  \"salary\": 95000,\n  \"department\": \"Engineering\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/employees/{{employeeId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "employees", "{{employeeId}}"]
            },
            "description": "Update an existing employee. Only include fields you want to update."
          },
          "response": []
        },
        {
          "name": "Delete Employee",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/employees/{{employeeId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "employees", "{{employeeId}}"]
            },
            "description": "Delete an employee by their ID."
          },
          "response": []
        },
        {
          "name": "Search Employees",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/employees/search?q=john",
              "host": ["{{baseUrl}}"],
              "path": ["api", "employees", "search"],
              "query": [
                {
                  "key": "q",
                  "value": "john",
                  "description": "Search term (searches in name and email)"
                }
              ]
            },
            "description": "Search employees by name or email."
          },
          "response": []
        }
      ],
      "description": "Employee CRUD operations (all protected with Cognito authentication)"
    }
  ]
}
